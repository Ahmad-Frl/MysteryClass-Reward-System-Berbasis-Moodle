a:43:{s:10:"brandcolor";s:7:"#0f47ad";s:18:"disableteacherspic";s:1:"1";s:19:"displaymarketingbox";s:1:"1";s:17:"enablecourseindex";s:1:"1";s:8:"facebook";s:0:"";s:8:"faqcount";s:1:"0";s:7:"favicon";s:48:"/Gemini_Generated_Image_lrpy29lrpy29lrpy (2).ico";s:8:"fontsite";s:6:"Roboto";s:15:"googleanalytics";s:0:"";s:9:"instagram";s:0:"";s:8:"linkedin";s:0:"";s:10:"loginbgimg";s:44:"/Gemini_Generated_Image_hey9pxhey9pxhey9.png";s:4:"logo";s:44:"/Gemini_Generated_Image_3itx5s3itx5s3itx.png";s:4:"mail";s:0:"";s:17:"marketing1content";s:270:"Mata pelajaran Perencanaan dan Pengalamatan Jaringan mempelajari cara merancang topologi, memilih perangkat, serta mengatur pengalamatan IP (IPv4/IPv6) secara efisien. Fokus utamanya adalah membangun jaringan yang terstruktur, aman, dan handal sesuai kebutuhan pengguna.";s:17:"marketing1heading";s:35:"Perencanaan & Pengalamatan Jaringan";s:14:"marketing1icon";s:9:"/PPJ.jpeg";s:17:"marketing2content";s:368:"Mata pelajaran Teknologi Jaringan Kabel dan Nirkabel berfokus pada kompetensi instalasi, konfigurasi, perawatan, dan perbaikan infrastruktur jaringan komputer, baik menggunakan media fisik (kabel) maupun gelombang radio (nirkabel). Peserta didik mempelajari pemasangan kabel fiber optik/UTP, konfigurasi access point, keamanan jaringan, dan manajemen koneksi internet.";s:17:"marketing2heading";s:37:"Teknologi Jaringan Kabel dan Nirkabel";s:14:"marketing2icon";s:10:"/TJKN.jpeg";s:17:"marketing3content";s:320:"Mata pelajaran Keamanan Jaringan adalah studi yang mempelajari teknik, kebijakan, dan prosedur untuk melindungi integritas, kerahasiaan, dan ketersediaan data serta infrastruktur jaringan komputer dari akses tidak sah, penyalahgunaan, atau serangan siber. Materi ini fokus pada pencegahan, deteksi, dan mitigasi ancaman.";s:17:"marketing3heading";s:17:"Keamanan Jaringan";s:14:"marketing3icon";s:8:"/KJ.jpeg";s:17:"marketing4content";s:291:"Pemasangan dan Konfigurasi Perangkat Jaringan (PKPJ) adalah mata pelajaran yang fokus pada keterampilan praktis merancang, memasang, dan mengatur perangkat keras serta perangkat lunak jaringan, seperti switch dan router, untuk membentuk LAN/WLAN yang berfungsi optimal sesuai prosedur kerja.";s:17:"marketing4heading";s:45:"Pemasangan dan Konfigurasi Perangkat Jaringan";s:14:"marketing4icon";s:10:"/PKPJ.jpeg";s:16:"marketingcontent";s:26:"LEARNING MANAGEMENT SYSTEM";s:16:"marketingheading";s:28:"TEKNIK KOMPUTER DAN JARINGAN";s:6:"mobile";s:0:"";s:16:"numbersfrontpage";s:1:"1";s:23:"numbersfrontpagecontent";s:0:"";s:6:"preset";s:12:"default.scss";s:11:"presetfiles";s:0:"";s:4:"scss";s:0:"";s:7:"scsspre";s:0:"";s:18:"secondarymenucolor";s:7:"#0f47ad";s:11:"slidercount";s:1:"0";s:8:"telegram";s:0:"";s:7:"twitter";s:0:"";s:7:"version";s:10:"2022112801";s:7:"website";s:0:"";s:8:"whatsapp";s:0:"";s:7:"youtube";s:0:"";}