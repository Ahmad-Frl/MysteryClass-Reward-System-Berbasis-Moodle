a:59:{s:7:"additem";s:8:"Add item";s:11:"additemgain";s:16:"Add item to gain";s:11:"additemloss";s:16:"Add item to loss";s:15:"additemlocation";s:24:"Add item and create drop";s:19:"additemsandlocation";s:19:"Add items and drops";s:11:"addlocation";s:8:"Add drop";s:15:"addlocationitem";s:24:"Add a drop for this item";s:8:"addtrade";s:11:"Add a trade";s:9:"addtrades";s:61:"Click 'Add a trade' to configure a trade to be inserted here.";s:11:"buttontitle";s:17:"Insert stash item";s:6:"choose";s:10:"Choose ...";s:11:"createitems";s:45:"Create items and a drop to configure it here.";s:18:"collectioninterval";s:19:"Collection interval";s:22:"collectionintervaltime";s:24:"Collection interval time";s:10:"dropselect";s:40:"Select an item or trade to insert a code";s:15:"generaloverview";s:16:"General overview";s:4:"help";s:109:"Stash is a series of plugins that allows you to add items around the course for students to find and collect.";s:5:"help2";s:175:"This editor plugin allows you to create items and tie them to a drop. The drop and its associated information is what is added to this text area for students to interact with.";s:5:"help3";s:44:"More detailed information is available here:";s:12:"helplinktext";s:16:"Add a stash code";s:12:"imagewarning";s:32:"Please add an image for the item";s:4:"item";s:4:"Item";s:9:"itemhelp1";s:142:"Items are the base elements that students collect in your course. The hard requirements for creating an item are a name for it, and a picture.";s:9:"itemhelp2";s:103:"The optional settings for creating an item are whether it is scarce or not, and details about the item.";s:9:"itemhelp3";s:154:"Scarce items are limited to a course. If you select this option and then specify a number such as '5', there will only be five of this item in the course.";s:9:"itemhelp4";s:101:"Details about the item is text that the student will see when they click on this item in their stash.";s:12:"itemhelplink";s:28:"Items and how to create them";s:5:"items";s:5:"Items";s:16:"itemsandlocation";s:32:"Drop configuration and insertion";s:13:"itemsandtrade";s:15:"Trade insertion";s:8:"location";s:8:"Location";s:12:"locationhelp";s:355:"Drops are a way to place items into the course multiple times. If you have a common item that you reward your students with (e.g. Money), instead of creating multiple money items, you just create another drop for that item. Each item can be configured to limit how many of the item are available, how often they spawn, and if there is an unlimited supply.";s:13:"locationhelp2";s:167:"The Drop configurations have a location name for your benefit only. This is used to remind you were this item is located (if you are in the general management screen).";s:13:"locationhelp3";s:107:"This plugin will have a guess at a location name for your drop. You are free to change it to anything else.";s:13:"locationhelp4";s:182:"Drops can be displayed in three different ways: As a link, Only and image, or as an image with a button. The last option is the most obvious for students to identify as a stash item.";s:16:"locationhelplink";s:27:"Drops and what they are for";s:14:"locationneeded";s:11:"Drop needed";s:9:"locations";s:5:"Drops";s:12:"modalheading";s:17:"Stash code helper";s:11:"namewarning";s:30:"Please add a name for the item";s:7:"noitems";s:17:"You have no items";s:11:"nolocations";s:79:"Please create a drop to configure here, before being inserted into this editor.";s:8:"notrades";s:36:"You currently have no trades created";s:6:"pickup";s:8:"Pick up!";s:10:"pluginname";s:10:"Tiny stash";s:16:"privacy:metadata";s:31:"This plugin stores no user data";s:15:"snippetinserter";s:16:"Snippet inserter";s:8:"supplies";s:8:"Supplies";s:9:"tradehelp";s:89:"Trades are a widget that allows students to hand in items in exchange for something else.";s:10:"tradehelp2";s:122:"When configuring a trade, all items on the left are what the student will get. Items on the right are what they will lose.";s:10:"tradehelp3";s:165:"Trade widgets are put into the course in the same way that drops are. Selecting a trade from the trade insertion screen will show a preview of what will be inserted.";s:13:"tradehelplink";s:27:"Trades and when to use them";s:6:"trades";s:6:"Trades";s:9:"unlimited";s:9:"Unlimited";s:5:"weeks";s:5:"weeks";s:4:"days";s:4:"days";s:5:"hours";s:5:"hours";s:7:"minutes";s:7:"minutes";s:7:"seconds";s:7:"seconds";}