<div class="utp-game-container" id="utp-app">
    <h2>Mini-Game: Susun & Crimp Kabel UTP (T568B)</h2>
    <p><strong>Instruksi:</strong> Klik kabel di kotak "Kabel Acak" untuk menyusunnya ke pin konektor RJ45 di atas sesuai standar <strong>T568B (Straight)</strong>. Jika salah, klik kabel di RJ45 untuk menurunkannya kembali.</p>
    
    <div class="utp-board">
        <h3>Konektor RJ45 (Pin 1 - 8)</h3>
        <div id="utp-target" class="utp-slot-area">
            </div>
        <div id="utp-rj45-overlay" class="rj45-overlay" style="display:none;">
            [ KONEKTOR RJ45 TERKUNCI ]
        </div>
    </div>

    <div class="utp-controls">
        <button id="btn-cek" class="utp-btn utp-btn-primary" onclick="cekSusunan()">1. Cek Susunan</button>
        <button id="btn-crimp" class="utp-btn utp-btn-success" style="display:none;" onclick="lakukanCrimping()">2. Potong & Crimp!</button>
        <button class="utp-btn utp-btn-danger" onclick="resetGame()">Reset / Ulangi</button>
    </div>
    
    <p id="utp-message" class="utp-msg">Silakan mulai menyusun kabel dari kiri ke kanan.</p>

    <div class="utp-board">
        <h3>Kabel Acak</h3>
        <div id="utp-source" class="utp-slot-area">
            </div>
    </div>
</div>

<style>
    /* =========================================
       CSS TAMPILAN (ANTI BENTROK DENGAN MOODLE)
       ========================================= */
    .utp-game-container {
        font-family: 'Segoe UI', Arial, sans-serif;
        max-width: 650px;
        margin: 20px auto;
        padding: 20px;
        background: #f8f9fa;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .utp-game-container h2 { margin-top: 0; color: #343a40; font-size: 1.4rem; font-weight: bold;}
    .utp-game-container p { font-size: 0.95rem; color: #495057; line-height: 1.5;}
    
    .utp-board {
        background: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 8px;
        margin: 15px 0;
        padding: 10px;
        position: relative;
    }
    .utp-board h3 { margin: 0 0 10px 0; font-size: 1rem; color: #495057; font-weight: bold;}
    
    .utp-slot-area {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 6px;
        min-height: 120px;
        padding: 10px;
        background: #e9ecef;
        border-radius: 6px;
        border: 2px dashed #adb5bd;
    }
    
    .utp-wire {
        width: 35px;
        height: 110px;
        cursor: pointer;
        border: 1px solid #343a40;
        border-radius: 4px;
        transition: all 0.2s ease;
        box-shadow: 1px 1px 3px rgba(0,0,0,0.3);
    }
    .utp-wire:hover { transform: translateY(-5px); filter: brightness(1.1); }
    
    /* --- PENGATURAN WARNA VISUAL KABEL --- */
    /* Putih-Oranye (Garis-garis) */
    .w-po { background: repeating-linear-gradient(45deg, #fff, #fff 5px, #fd7e14 5px, #fd7e14 10px); }
    /* Oranye Polos */
    .w-o  { background: #fd7e14; }
    /* Putih-Hijau (Garis-garis) */
    .w-ph { background: repeating-linear-gradient(45deg, #fff, #fff 5px, #28a745 5px, #28a745 10px); }
    /* Biru Polos */
    .w-b  { background: #007bff; }
    /* Putih-Biru (Garis-garis) */
    .w-pb { background: repeating-linear-gradient(45deg, #fff, #fff 5px, #007bff 5px, #007bff 10px); }
    /* Hijau Polos */
    .w-h  { background: #28a745; }
    /* Putih-Cokelat (Garis-garis) */
    .w-pc { background: repeating-linear-gradient(45deg, #fff, #fff 5px, #8b4513 5px, #8b4513 10px); }
    /* Cokelat Polos */
    .w-c  { background: #8b4513; }

    /* Efek saat kabel dipotong (Crimping) */
    .wire-cut { 
        height: 80px !important; 
        border-top-left-radius: 0; 
        border-top-right-radius: 0; 
        border-top: 3px solid #ffd700;
    }

    /* Tampilan RJ45 yang menutupi kabel */
    .rj45-overlay {
        position: absolute;
        top: 30px; left: 50%;
        transform: translateX(-50%);
        width: 380px; height: 50px;
        background: rgba(255, 255, 255, 0.85);
        border: 3px solid #ffc107;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #856404;
        z-index: 10;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }

    /* Tampilan Tombol */
    .utp-btn {
        padding: 10px 15px; margin: 5px; font-weight: bold; border: none; border-radius: 6px; cursor: pointer; transition: 0.2s; font-size: 0.9rem;
    }
    .utp-btn-primary { background: #007bff; color: white; }
    .utp-btn-primary:hover { background: #0056b3; }
    .utp-btn-success { background: #28a745; color: white; }
    .utp-btn-success:hover { background: #218838; }
    .utp-btn-danger { background: #dc3545; color: white; }
    .utp-btn-danger:hover { background: #c82333; }
    
    /* Pesan Status */
    .utp-msg { font-weight: bold; font-size: 1.1rem; min-height: 25px; margin: 10px 0; padding: 10px; border-radius: 5px;}
    .msg-normal { background: #e2e3e5; color: #383d41; }
    .msg-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .msg-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
</style>

<script>
    /* =========================================
       JAVASCRIPT LOGIKA GAME (100% BEKERJA)
       ========================================= */
    
    // Kunci Jawaban Standar T568B (Straight)
    const correctOrder = ['w-po', 'w-o', 'w-ph', 'w-b', 'w-pb', 'w-h', 'w-pc', 'w-c'];
    
    // Data Kabel (Nama Teks yang muncul saat disentuh kursor)
    const wiresData = [
        { id: 'w-po', class: 'w-po', title: 'Putih-Oranye' },
        { id: 'w-o', class: 'w-o', title: 'Oranye' },
        { id: 'w-ph', class: 'w-ph', title: 'Putih-Hijau' },
        { id: 'w-b', class: 'w-b', title: 'Biru' },
        { id: 'w-pb', class: 'w-pb', title: 'Putih-Biru' },
        { id: 'w-h', class: 'w-h', title: 'Hijau' },
        { id: 'w-pc', class: 'w-pc', title: 'Putih-Cokelat' },
        { id: 'w-c', class: 'w-c', title: 'Cokelat' }
    ];

    let sourceW = [];
    let targetW = [];
    let isCrimped = false;

    // Fungsi untuk mengacak urutan kabel di bawah
    function shuffle(array) {
        let currentIndex = array.length, randomIndex;
        while (currentIndex !== 0) {
            randomIndex = Math.floor(Math.random() * currentIndex);
            currentIndex--;
            [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
        }
        return array;
    }

    // Fungsi memulai / mereset game
    function initGame() {
        sourceW = shuffle([...wiresData]);
        targetW = [];
        isCrimped = false;
        
        document.getElementById('btn-crimp').style.display = 'none';
        document.getElementById('btn-cek').style.display = 'inline-block';
        document.getElementById('utp-rj45-overlay').style.display = 'none';
        
        showMessage("Silakan mulai menyusun kabel dari kiri ke kanan.", "msg-normal");
        renderWires();
    }

    // Fungsi memindahkan kabel saat diklik
    function moveWire(id, fromSource) {
        if (isCrimped) return; // Kunci permainan jika sudah di-crimp

        if (fromSource) {
            if (targetW.length >= 8) return; // Slot atas maksimal 8
            const index = sourceW.findIndex(w => w.id === id);
            targetW.push(sourceW[index]);
            sourceW.splice(index, 1);
        } else {
            const index = targetW.findIndex(w => w.id === id);
            sourceW.push(targetW[index]);
            targetW.splice(index, 1);
        }
        renderWires();
    }

    // Fungsi menggambar ulang kabel di layar
    function renderWires() {
        const sourceDiv = document.getElementById('utp-source');
        const targetDiv = document.getElementById('utp-target');
        
        sourceDiv.innerHTML = '';
        targetDiv.innerHTML = '';

        sourceW.forEach(w => {
            const el = document.createElement('div');
            el.className = `utp-wire ${w.class}`;
            el.title = w.title;
            el.onclick = () => moveWire(w.id, true);
            sourceDiv.appendChild(el);
        });

        targetW.forEach(w => {
            const el = document.createElement('div');
            el.className = `utp-wire ${w.class}`;
            if(isCrimped) el.classList.add('wire-cut'); // Efek potong rata jika dicrimp
            el.title = w.title;
            el.onclick = () => moveWire(w.id, false);
            targetDiv.appendChild(el);
        });
    }

    // Fungsi untuk mengecek jawaban
    function cekSusunan() {
        if (targetW.length < 8) {
            showMessage("Pindahkan semua (8) kabel ke atas terlebih dahulu!", "msg-error");
            return;
        }

        let isCorrect = true;
        for (let i = 0; i < 8; i++) {
            if (targetW[i].id !== correctOrder[i]) {
                isCorrect = false;
                break;
            }
        }

        if (isCorrect) {
            showMessage("Susunan BENAR! Silakan lanjut ke proses Crimping.", "msg-success");
            document.getElementById('btn-cek').style.display = 'none';
            document.getElementById('btn-crimp').style.display = 'inline-block';
        } else {
            showMessage("Susunan masih SALAH. Cek kembali urutan T568B!", "msg-error");
        }
    }

    // Fungsi animasi crimping
    function lakukanCrimping() {
        isCrimped = true;
        renderWires(); // Memicu efek potong rata
        document.getElementById('utp-rj45-overlay').style.display = 'flex';
        document.getElementById('btn-crimp').style.display = 'none';
        
        showMessage("🎉 CRIMPING BERHASIL! Kabel telah dipotong rata dan terkunci di dalam pin RJ45.", "msg-success");
    }

    // Fungsi reset
    function resetGame() {
        initGame();
    }

    // Fungsi ganti teks pesan
    function showMessage(text, className) {
        const msgDiv = document.getElementById('utp-message');
        msgDiv.textContent = text;
        msgDiv.className = `utp-msg ${className}`;
    }

    // --- JALANKAN GAME SAAT PERTAMA KALI DIMUAT ---
    // Menggunakan setTimeout untuk memastikan DOM Moodle sudah siap
    setTimeout(initGame, 100);
</script>